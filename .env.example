# ==============================================================================
# Inventory Management System - Environment Variables Example
# Copy this file to .env to customize local or deployment environments
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_EXTERNAL_PORT=5433

# Backend Service Configuration (Spring Boot)
DB_HOST=localhost
DB_PORT=5433
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80,http://127.0.0.1:3000

# Frontend Service Configuration (React Vite)
VITE_API_BASE_URL=http://localhost:8080/api
